<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0" />

    <com.plasmacam.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.plasmacam.SensorFieldView
        android:id="@+id/sensorFieldView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC000000">

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="Manual Sensor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:text="ISO" />

            <SeekBar
                android:id="@+id/seekSensitivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="70" />

            <TextView
                android:id="@+id/tvSensitivity"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:gravity="end"
                android:text="800" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:text="Exposure" />

            <SeekBar
                android:id="@+id/seekAmplify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="45" />

            <TextView
                android:id="@+id/tvAmplify"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:textColor="#FFAA00"
                android:textSize="12sp"
                android:gravity="end"
                android:text="10ms" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="NEXT MODE" />

    </LinearLayout>

    <com.plasmacam.XRayVisionView
        android:id="@+id/xrayVisionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
